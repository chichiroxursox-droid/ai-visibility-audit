<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ v.business_name }} — Visibility Audit</title>
<style>
  :root{
    --ink:#14313a; --ink-2:#3c5560; --line:#e4e8ea; --bg:#f3f1ec; --card:#ffffff;
    --accent:#e0853a; --muted:#7c8a90; --good:#1faa59; --warn:#f5a623; --bad:#e2403b;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    line-height:1.5;-webkit-font-smoothing:antialiased}
  .page{max-width:820px;margin:32px auto;background:var(--card);border-radius:14px;
    box-shadow:0 12px 40px rgba(20,49,58,.10);overflow:hidden}
  .pad{padding:38px 46px}
  h1,h2,h3{font-family:Georgia,"Times New Roman",serif;font-weight:600;color:var(--ink);margin:0}
  .eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);
    font-weight:700;font-family:-apple-system,Segoe UI,Roboto,sans-serif}
  .muted{color:var(--muted)}
  a{color:var(--ink)}

  /* header */
  header{background:var(--ink);color:#fff;padding:30px 46px}
  header .brand{font-size:13px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:#cfe0e4}
  header h1{color:#fff;font-size:34px;margin-top:14px;line-height:1.15}
  header .sub{color:#aebfc5;margin-top:8px;font-size:15px}

  /* hero score */
  .hero{display:flex;gap:34px;align-items:center;border-bottom:1px solid var(--line)}
  .ring{flex:0 0 168px;width:168px;height:168px;border-radius:50%;display:flex;align-items:center;
    justify-content:center;position:relative}
  .ring .inner{width:128px;height:128px;background:var(--card);border-radius:50%;display:flex;
    flex-direction:column;align-items:center;justify-content:center}
  .ring .num{font-family:Georgia,serif;font-size:46px;font-weight:700;line-height:1}
  .ring .den{font-size:13px;color:var(--muted);margin-top:2px}
  .hero .headline{font-size:23px;line-height:1.32;margin-bottom:10px}
  .pill{display:inline-block;font-size:12px;font-weight:700;padding:4px 11px;border-radius:999px;
    color:#fff;letter-spacing:.03em}

  /* breakdown bars */
  .bars{display:grid;grid-template-columns:1fr 1fr;gap:14px 30px;margin-top:8px}
  .bar .top{display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px}
  .bar .track{height:9px;background:#edf1f2;border-radius:6px;overflow:hidden}
  .bar .fill{height:100%;border-radius:6px}

  section{border-top:1px solid var(--line);break-inside:avoid}
  h2.section{font-size:21px;margin-bottom:4px}
  .lead{color:var(--ink-2);margin:6px 0 18px}

  /* competitor table */
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line)}
  th{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700}
  td.num{text-align:right;font-variant-numeric:tabular-nums}
  tr.you{background:#fbf4ec}
  tr.you td{font-weight:700;color:var(--ink)}
  .tag-you{font-size:10px;background:var(--accent);color:#fff;padding:1px 7px;border-radius:999px;margin-left:6px;vertical-align:middle}

  /* AIO money shot */
  .engine{border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:14px;break-inside:avoid}
  .engine .row{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .engine .name{font-weight:700;font-size:15px}
  .verdict{font-size:13px;font-weight:700;padding:5px 12px;border-radius:999px;white-space:nowrap}
  .verdict.yes{background:#e7f6ee;color:var(--good)}
  .verdict.partial{background:#fff4e3;color:#b9701f}
  .verdict.no{background:#fdeceb;color:var(--bad)}
  .verdict.na{background:#eef1f2;color:var(--muted)}
  .chips{margin-top:10px;display:flex;flex-wrap:wrap;gap:6px}
  .chip{font-size:11px;background:#eef2f3;color:var(--ink-2);padding:3px 9px;border-radius:6px}
  .chip.comp{background:#fdeceb;color:#a3322c}
  .snippet{margin-top:10px;font-size:13px;color:var(--ink-2);background:#f7f9f9;border-left:3px solid var(--line);
    padding:9px 12px;border-radius:0 6px 6px 0}
  .stat-strip{background:#fbf4ec;border:1px solid #f1e2cf;border-radius:10px;padding:14px 18px;margin-bottom:18px;font-size:14px;color:#7a5526}

  /* gaps + fixes lists */
  ul.clean{list-style:none;margin:0;padding:0}
  ul.clean li{padding:9px 0;border-bottom:1px solid var(--line);font-size:14px;display:flex;gap:10px}
  ul.clean li:last-child{border-bottom:none}
  .dot{flex:0 0 8px;width:8px;height:8px;border-radius:50%;margin-top:7px;background:var(--bad)}
  .fix{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--line);break-inside:avoid}
  .fix:last-child{border-bottom:none}
  .prio{flex:0 0 70px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;
    padding-top:2px}
  .prio.high{color:var(--bad)} .prio.medium{color:var(--warn)} .prio.low{color:var(--muted)}
  .fix .ttl{font-weight:700;margin-bottom:3px}
  .fix .why{font-size:13.5px;color:var(--ink-2)}
  .fix .svc{font-size:12px;color:var(--accent);font-weight:600;margin-top:4px}

  .cta{background:var(--ink);color:#fff;border-radius:12px;padding:26px 30px;text-align:center}
  .cta h3{color:#fff;font-size:22px;margin-bottom:8px}
  .cta p{color:#bcccd1;margin:0 0 4px}

  footer{padding:22px 46px;font-size:11.5px;color:var(--muted);background:#fafbfb;border-top:1px solid var(--line)}
  footer p{margin:4px 0}

  @media print{
    body{background:#fff}
    .page{box-shadow:none;margin:0;max-width:none;border-radius:0}
    section,.engine,.fix{break-inside:avoid}
  }
</style>
</head>
<body>
<div class="page">

  <header>
    <div class="brand">{{ v.brand }} · AI Visibility Audit</div>
    <h1>{{ v.business_name }}</h1>
    <div class="sub">
      {% if v.category %}{{ v.category }}{% endif %}{% if v.city %} · {{ v.city }}{% endif %}
      {% if v.generated %} · {{ v.generated }}{% endif %}
    </div>
  </header>

  <!-- HERO SCORE -->
  <div class="pad hero">
    <div class="ring" style="background:conic-gradient({{ v.score_color }} {{ (v.score or 0) }}%, #eceff1 0)">
      <div class="inner">
        <div class="num" style="color:{{ v.score_color }}">{{ v.score if v.score is not none else '—' }}</div>
        <div class="den">out of 100</div>
      </div>
    </div>
    <div>
      <div class="eyebrow">Your visibility score</div>
      <div class="headline">{{ v.narrative.headline or 'Here is how visible your business is online — and to AI.' }}</div>
      <span class="pill" style="background:{{ v.score_color }}">{{ v.score_label }}</span>
      <div class="bars">
        {% for b in v.breakdown %}
        <div class="bar">
          <div class="top"><span>{{ b.label }}</span><span class="muted">{{ b.value if b.value is not none else '—' }}{% if b.value is not none %}/100{% endif %}</span></div>
          <div class="track"><div class="fill" style="width:{{ b.value or 0 }}%;background:{{ b.color }}"></div></div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- AIO MONEY SHOT -->
  <section class="pad">
    <div class="eyebrow">The big one</div>
    <h2 class="section">What AI assistants say when someone asks for the best {{ v.aio_category or v.category or 'business' }} {% if v.city %}in {{ v.city }}{% endif %}</h2>
    <p class="lead">{{ v.narrative.aio_verdict or 'We asked the AI assistants your customers use. Here is what came back.' }}</p>
    {% if v.aio_summary.samples_per_engine %}
    <p class="muted" style="font-size:12.5px;margin:-6px 0 14px">
      We asked each assistant <strong>{{ v.aio_summary.samples_per_engine }}</strong> times across {{ v.aio_queries|length }} ways a customer might phrase it, because AI answers shift from one ask to the next.{% if v.aio_summary.trend_only %} It’s a small sample — read it as a directional snapshot, not a guaranteed percentage.{% endif %}
    </p>
    {% endif %}
    <div class="stat-strip">
      Only <strong>~1.2%</strong> of local businesses show up in ChatGPT and <strong>~7.4%</strong> in Perplexity — versus <strong>~36%</strong> in Google’s local results. The businesses that get there now own the next decade of “near me” searches.
    </div>

    {% if v.engines %}
      {% for e in v.engines %}
      <div class="engine">
        <div class="row">
          <span class="name">{{ e.label }}</span>
          {% if e.error %}
            <span class="verdict na">Not checked</span>
          {% elif e.stability == 'not_served' %}
            {% if e.local_pack_rank %}
              <span class="verdict yes">✓ #{{ e.local_pack_rank }} in Google's local pack</span>
            {% else %}
              <span class="verdict na">No AI Overview for this search</span>
            {% endif %}
          {% elif e.samples %}
            {% if e.recommended_count and e.stability == 'consistent' %}
              <span class="verdict yes">✓ Recommended every time ({{ e.named_in }})</span>
            {% elif e.recommended_count %}
              <span class="verdict partial">◐ Named in {{ e.named_in }} answers ({{ e.rate_pct }}%)</span>
            {% else %}
              <span class="verdict no">✗ Not named in {{ e.samples }} tries</span>
            {% endif %}
          {% elif not e.present %}
            <span class="verdict na">No AI answer shown</span>
          {% elif e.mentioned %}
            <span class="verdict yes">✓ You were recommended</span>
          {% else %}
            <span class="verdict no">✗ You were not mentioned</span>
          {% endif %}
        </div>
        {% if e.competitors_mentioned %}
          <div class="chips"><span class="muted" style="font-size:12px;align-self:center">It recommended instead:</span>
          {% for c in e.competitors_mentioned %}<span class="chip comp">{{ c }}</span>{% endfor %}</div>
        {% endif %}
        {% if e.cited_domains %}
          <div class="chips"><span class="muted" style="font-size:12px;align-self:center">Sources it trusted:</span>
          {% for d in e.cited_domains[:8] %}<span class="chip">{{ d }}</span>{% endfor %}</div>
        {% endif %}
        {% if e.cited_as_source and not e.recommended %}
          <div class="snippet" style="border-left-color:var(--warn)">Your own website was one of the sources this assistant read — but it still recommended other businesses, not you.</div>
        {% endif %}
        {% if e.organic_rank %}
          <div class="snippet" style="border-left-color:var(--muted)"><strong>Why this happens:</strong> you sit around <strong>#{{ e.organic_rank }}</strong> in Google's classic (blue-link) results for this search. AI assistants rarely cite past the top results, so your organic ranking is the upstream lever that feeds everything above.</div>
        {% endif %}
        {% if e.stability == 'not_served' %}
          <div class="snippet">Google didn’t generate an AI Overview for this search — for local “best…” queries it answers with the <strong>map pack</strong>{% if e.local_pack_rank %}, where you rank <strong>#{{ e.local_pack_rank }}</strong>{% if e.local_pack_top %} (top: {{ e.local_pack_top[:3] | join(', ') }}){% endif %}{% endif %}. That’s a different surface than ChatGPT/Perplexity — not an absence.</div>
        {% elif e.mention_snippet %}
          <div class="snippet"><strong>Where you appeared:</strong> {{ e.mention_snippet }}</div>
        {% elif e.answer %}
          <div class="snippet">“{{ e.answer }}”</div>
        {% endif %}
      </div>
      {% endfor %}
    {% else %}
      <p class="muted">AI-assistant visibility wasn’t checked for this run (add the AI keys to enable it).</p>
    {% endif %}
  </section>

  <!-- REVIEWS VS COMPETITORS -->
  {% if v.competitors %}
  <section class="pad">
    <div class="eyebrow">Reputation</div>
    <h2 class="section">You vs. your nearest competitors</h2>
    <p class="lead">{{ v.narrative.vs_competitors or 'How your Google rating and review volume stack up against the businesses you compete with.' }}</p>
    <table>
      <thead><tr><th>Business</th><th class="num">Rating</th><th class="num">Reviews</th></tr></thead>
      <tbody>
        <tr class="you">
          <td>{{ v.business_name }}<span class="tag-you">YOU</span></td>
          <td class="num">{{ '%.1f'|format(v.my_rating) if v.my_rating is not none else '—' }}</td>
          <td class="num">{{ v.my_reviews }}</td>
        </tr>
        {% for c in v.competitors %}
        <tr>
          <td>{{ c.name }}</td>
          <td class="num">{{ '%.1f'|format(c.rating) if c.rating is not none else '—' }}</td>
          <td class="num">{{ c.review_count if c.review_count is not none else '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  <!-- GOOGLE PROFILE -->
  {% if v.google.completeness_score is not none %}
  <section class="pad">
    <div class="eyebrow">Google Business Profile</div>
    <h2 class="section">Your profile is {{ v.google.completeness_score }}% complete</h2>
    {% if v.google.missing %}
    <p class="lead">Every missing piece below is a reason Google ranks you lower and customers scroll past:</p>
    <ul class="clean">
      {% for m in v.google.missing %}<li><span class="dot"></span><span>Missing: {{ m }}</span></li>{% endfor %}
    </ul>
    {% else %}
    <p class="lead">Your core profile fields are filled in — nice work. The gains now come from reviews, content, and AI visibility above.</p>
    {% endif %}
  </section>
  {% endif %}

  <!-- WEBSITE -->
  {% if v.website.gaps %}
  <section class="pad">
    <div class="eyebrow">Website</div>
    <h2 class="section">{% if v.website.analyzable == false and v.website.url %}We couldn’t read your website{% else %}What your website is missing{% endif %}</h2>
    {% if v.website.pagespeed and v.website.pagespeed.performance is not none %}
    <p class="lead">Mobile speed score: <strong>{{ v.website.pagespeed.performance }}/100</strong>{% if v.website.pagespeed.seo is not none %} · Technical SEO: <strong>{{ v.website.pagespeed.seo }}/100</strong>{% endif %}.</p>
    {% endif %}
    <ul class="clean">
      {% for g in v.website.gaps %}<li><span class="dot"></span><span>{{ g }}</span></li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  <!-- FIX LIST -->
  {% if v.fixes %}
  <section class="pad">
    <div class="eyebrow">Your roadmap</div>
    <h2 class="section">What we’d fix for you — in priority order</h2>
    <div>
      {% for f in v.fixes %}
      <div class="fix">
        <div class="prio {{ f.priority }}">{{ f.priority }}</div>
        <div>
          <div class="ttl">{{ f.title }}</div>
          <div class="why">{{ f.why }}</div>
          {% if f.service %}<div class="svc">→ {{ f.service }}</div>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- CTA -->
  <section class="pad">
    <div class="cta">
      <h3>Want all of this done for you?</h3>
      <p>You don’t have to learn any of this. We handle your Google profile, reviews, website, and AI visibility — you just get more calls.</p>
      <p style="margin-top:10px"><strong>Reply to this report and we’ll get you found.</strong></p>
    </div>
  </section>

  <footer>
    <p>Powered by data from Google, and live queries to ChatGPT, Perplexity, and Google’s AI Overview. AI-assistant answers are a snapshot{% if v.generated %} from {{ v.generated }}{% endif %} and vary by location and over time.</p>
    <p>Business listing data and competitor information provided by Google. Google and the Google logo are trademarks of Google LLC.</p>
    <p>{{ v.brand }} · AI Visibility Audit{% if v.cost is not none %} · run cost ${{ '%.2f'|format(v.cost) }}{% endif %}</p>
  </footer>

</div>
</body>
</html>
