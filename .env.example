# AI Visibility Audit — TEMPLATE. Copy this file to `.env` and put your real keys THERE.
# This file is committed to git, so it must contain NO real secrets — placeholders only.
# Cost per audit is roughly $0.10–0.20; free tiers cover the pilot.

# --- Google Maps Platform: Places API (New) — business profile + competitors ---
# Setup: console.cloud.google.com -> create project -> enable billing
#   -> APIs & Services > Library > "Places API (New)" > Enable
#   -> Credentials > Create credentials > API key.
# Free tier: thousands of events/mo + $300 trial credit. ~$0.05/audit after.
GOOGLE_MAPS_API_KEY=

# --- PageSpeed Insights (website speed/mobile) ---
# Keyless works but is HEAVILY rate-limited (429s in practice). Keys made through the Maps wizard
# are often scoped to Maps APIs and won't work here — if so, make a separate plain key with the
# "PageSpeed Insights API" enabled, or just leave this blank (the speed check degrades gracefully).
PAGESPEED_API_KEY=

# --- OpenAI: ChatGPT AIO check (Responses API + web_search tool) ---
# Setup: platform.openai.com -> API keys -> create key -> add prepaid credits. ~$0.05 per query.
OPENAI_API_KEY=

# --- Perplexity: Perplexity AIO check (sonar models, returns citations) ---
# Setup: perplexity.ai -> buy credits -> create API group -> generate key (starts with pplx-).
# ~$0.01 per query (cheapest engine).
PERPLEXITY_API_KEY=

# --- SerpAPI: Google AI Overview capture ---
# Setup: serpapi.com -> sign up -> copy API key. Free 250 searches/mo, then $25/mo.
SERPAPI_KEY=

# --- Synthesis backend: who writes the score + narrative + fix list ---
# Pick ONE with AUDIT_SYNTH_BACKEND (default 'anthropic'):
#   anthropic  -> Anthropic API, best quality, ~$0.06/audit   (needs ANTHROPIC_API_KEY)
#   groq       -> Groq free tier, genuinely $0, good draft     (needs GROQ_API_KEY, free signup)
#   claude_cli -> your local `claude` CLI / Claude Code plan    (no key; ~$0.30 EQUIVALENT per call
#                 from Claude Code's system-prompt overhead — only "free" on a flat subscription,
#                 and it spends your rate-limit quota. Not cheaper than the API on metered billing.)
#   heuristic  -> no LLM at all, $0, zero setup, weaker templated prose (just leave keys blank)
# AUDIT_SYNTH_BACKEND=anthropic

# Anthropic (backend 'anthropic'): console.anthropic.com -> API keys. Cents per audit.
ANTHROPIC_API_KEY=

# Groq (backend 'groq'): console.groq.com -> API Keys. Free tier.
GROQ_API_KEY=
# AUDIT_GROQ_MODEL=llama-3.3-70b-versatile
